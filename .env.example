# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Auth Config
PORT=3000
# Generate a unique, high-entropy value (at least 32 characters). Never commit it.
JWT_SECRET=
# Comma-separated production origins. The server rejects all other browser origins.
CORS_ORIGINS=https://app.example.com
# Firebase Admin credentials as a single JSON string, or use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional named Firestore database. Leave empty only when using the `(default)` database.
FIRESTORE_DATABASE_ID=
# Railway persistent Volume mount path for proof files. Example: /data/uploads
UPLOADS_DIR=
# Supabase is introduced in parallel during migration. Do not remove Firebase values
# until validation and the production cutover have completed.
SUPABASE_URL=
# Server-only secret. Never expose this value in Vite/browser variables.
SUPABASE_SERVICE_ROLE_KEY=
# firebase (default) keeps the current production database. Set supabase only after
# data validation and an explicit cutover deployment.
DATA_BACKEND=firebase
# Railway should use /api/health/ready as its health check once Firebase is configured.

